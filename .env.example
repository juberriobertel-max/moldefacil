# Supabase (Auth + Postgres + Storage + RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secreto exclusivo del servidor para firma de cookies de sesión/CSRF en modo vista previa
AUTH_COOKIE_SECRET=

# Resend (Correos transaccionales + SPF/DKIM/DMARC en dominio)
RESEND_API_KEY=
RESEND_FROM_EMAIL=MoldeFácil <hola@tudominio.com>

# Cloudflare Turnstile (Anti-bots en registro, recuperación y formularios sensibles)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Feature Flags de Comunidad (Fase 13 a 23; Fase 24 IA descartada por ahora)
NEXT_PUBLIC_FF_RETROALIMENTACION=true
NEXT_PUBLIC_FF_BIBLIOTECA_AJUSTES=true
NEXT_PUBLIC_FF_BITACORA=true
NEXT_PUBLIC_FF_PWA_AHORRO=true
NEXT_PUBLIC_FF_PORTAFOLIO=true
NEXT_PUBLIC_FF_SOLICITUDES_ENCARGO=true
NEXT_PUBLIC_FF_CIRCULOS=true
NEXT_PUBLIC_FF_MENTORIA=true
NEXT_PUBLIC_FF_RUTAS_GLOSARIO=true
NEXT_PUBLIC_FF_DIRECTORIO_TELAS=true